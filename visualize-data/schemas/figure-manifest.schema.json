{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/visualize-data/figure-manifest.schema.json",
  "title": "visualize-data figure manifest",
  "type": "object",
  "required": ["version", "figure", "outputs", "target", "panels", "checks"],
  "properties": {
    "version": {"const": 1},
    "figure": {
      "type": "object",
      "required": ["canonical_stem"],
      "properties": {"canonical_stem": {"type": "string", "minLength": 1}}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string"},
          {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}}}
        ]
      }
    },
    "target": {
      "type": "object",
      "required": ["width_mm"],
      "properties": {
        "width_mm": {"type": "number", "exclusiveMinimum": 0},
        "qa_dpi": {"type": "integer", "minimum": 72},
        "min_dpi": {"type": "number", "minimum": 1},
        "max_dpi": {"type": "number", "minimum": 1}
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "slot"],
        "properties": {
          "id": {"type": "string"},
          "source": {"type": "string"},
          "slot": {"$ref": "#/$defs/rect"},
          "min_clearance_px": {"type": "integer", "minimum": 0},
          "source_min_clearance_px": {"type": "integer", "minimum": 0},
          "allow_touch_edges": {"$ref": "#/$defs/edges"},
          "source_allow_touch_edges": {"$ref": "#/$defs/edges"}
        }
      }
    },
    "checks": {"type": "object"},
    "integrity": {"type": "object"},
    "review": {"type": "object"},
    "consistency": {"type": "object"},
    "quantitative": {"type": "object"},
    "deviations": {"type": "object"}
  },
  "$defs": {
    "rect": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "edges": {
      "type": "array",
      "items": {"enum": ["left", "right", "top", "bottom"]},
      "uniqueItems": true
    }
  }
}
